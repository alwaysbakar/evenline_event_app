rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function organizer() { return signedIn() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'organizer'; }

    match /users/{uid}/avatar/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }

    match /events/{eventId}/{fileName} {
      allow read: if true;
      allow write: if organizer() && firestore.get(/databases/(default)/documents/events/$(eventId)).data.ownerId == request.auth.uid && request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
  }
}
